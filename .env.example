# Copy to .env and fill in. NEVER commit .env.

# --- Anthropic ---
ANTHROPIC_API_KEY=sk-ant-...

# --- SendGrid (delivers the digest email) ---
SENDGRID_API_KEY=SG....
DIGEST_RECIPIENT=rafael.maldonado.sr@gmail.com
FROM_EMAIL=digest@mitechllc.com
FROM_NAME=Skool Digest

# --- Gmail (read-only on the "Skool" label) ---
# For CI: base64-encoded contents of token.json. Mint locally:
#   python -m skool_digest.gmail_fetch --auth
#   base64 -i token.json | pbcopy
GMAIL_TOKEN_B64=
